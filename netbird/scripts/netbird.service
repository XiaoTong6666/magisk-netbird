#!/system/bin/sh

DIR=$(dirname "$(realpath "$0")")
. "$DIR/../settings.sh"

program_name="netbird"
pid_file="$NB_RUN_DIR/netbird.pid"
cert_trust_script="$NB_SCRIPTS_DIR/cert-trust.sh"
module_status_script="$NB_SCRIPTS_DIR/module-status.sh"
overlay_rule_pref="90"
root_route_rule_pref="100"

is_running() {
  busybox pgrep -f "$NB_DAEMON_CMD" >/dev/null 2>&1
}

ensure_overlay_route_precedence() {
  if ip rule show 2>/dev/null | grep -q "lookup main suppress_prefixlength 0"; then
    return 0
  fi
  if ip rule add pref "$overlay_rule_pref" from all lookup main suppress_prefixlength 0 >/dev/null 2>&1; then
    return 0
  fi

  # Fallback for older Android iproute builds without suppress_prefixlength.
  if ! ip rule show 2>/dev/null | grep -q "to 100.64.0.0/10 lookup main"; then
    ip rule add pref "$overlay_rule_pref" to 100.64.0.0/10 lookup main >/dev/null 2>&1 || true
  fi
  if ! ip -6 rule show 2>/dev/null | grep -q "to fd00::/8 lookup main"; then
    ip -6 rule add pref "$overlay_rule_pref" to fd00::/8 lookup main >/dev/null 2>&1 || true
  fi
}

ensure_android_route() {
  ensure_overlay_route_precedence
  route_table="$(
    ip route show table all 2>/dev/null |
      awk '/^default / && $0 !~ / dev dummy0/ {
        for (i = 1; i <= NF; i++) {
          if ($i == "table") {
            print $(i + 1)
            exit
          }
        }
      }'
  )"
  if [ -z "$route_table" ]; then
    log Warning "No Android default route table found for root uid."
    return 0
  fi
  case "$route_table" in
    *[!0-9]*)
      route_table_id="$(
        awk -v name="$route_table" '$2 == name { print $1; exit }' \
          /data/misc/net/rt_tables /etc/iproute2/rt_tables 2>/dev/null || true
      )"
      [ -n "$route_table_id" ] && route_table="$route_table_id"
      ;;
  esac
  if ip rule show 2>/dev/null | grep -q "uidrange 0-0 lookup $route_table"; then
    return 0
  fi
  ip rule add pref "$root_route_rule_pref" from all uidrange 0-0 lookup "$route_table" >/dev/null 2>&1 ||
    log Warning "Failed to add root uid route rule for table $route_table."
}

ensure_rule() {
  "$@" -C "$rule_chain" $rule_args >/dev/null 2>&1 ||
    "$@" -I "$rule_chain" 1 $rule_args >/dev/null 2>&1 || true
}

ensure_netbird_icmp_firewall() {
  for iface in $(
    ip -o link show 2>/dev/null |
      awk -F': ' '$2 ~ /^(wt|wg|nb|netbird)/ { print $2 }' |
      cut -d@ -f1
  ); do
    rule_chain="INPUT"
    rule_args="-i $iface -p icmp -j ACCEPT"
    ensure_rule iptables
    rule_chain="OUTPUT"
    rule_args="-o $iface -p icmp -j ACCEPT"
    ensure_rule iptables

    if command -v ip6tables >/dev/null 2>&1; then
      rule_chain="INPUT"
      rule_args="-i $iface -p ipv6-icmp -j ACCEPT"
      ensure_rule ip6tables
      rule_chain="OUTPUT"
      rule_args="-o $iface -p ipv6-icmp -j ACCEPT"
      ensure_rule ip6tables
    fi
  done
}

refresh_runtime() {
  [ -x "$cert_trust_script" ] && "$cert_trust_script" update >/dev/null 2>&1 || true
  ensure_android_route
  ensure_netbird_icmp_firewall
}

update_module_status() {
  [ -x "$module_status_script" ] || return 0
  "$module_status_script" update >/dev/null 2>&1 || true
}

start_module_status() {
  [ -x "$module_status_script" ] || return 0
  "$module_status_script" start >/dev/null 2>&1 || true
}

stop_module_status() {
  [ -x "$module_status_script" ] || return 0
  "$module_status_script" stop >/dev/null 2>&1 || true
}

start_service() {
  log Info "Starting NetBird daemon."
  if is_running; then
    log Info "NetBird daemon is already running."
    refresh_runtime
    start_module_status
    return 0
  fi
  if ! command -v netbird >/dev/null 2>&1; then
    log Error "netbird binary not found."
    update_module_status
    return 1
  fi
  ensure_android_route
  rm -f "$NB_SOCKET"
  [ -f "$NB_LOG_FILE_PATH" ] && mv "$NB_LOG_FILE_PATH" "$NB_LOG_FILE_PATH.bak"
  # shellcheck disable=SC2086
  nohup $NB_DAEMON_CMD > "$NB_LOG_FILE_PATH" 2>&1 &
  pid="$!"
  sleep 3
  if ps -p "$pid" >/dev/null 2>&1; then
    echo "$pid" > "$pid_file"
    log Info "NetBird daemon started with PID $pid."
    start_module_status
    ( sleep 5; refresh_runtime; update_module_status ) >/dev/null 2>&1 &
    return 0
  fi
  log Error "NetBird daemon failed to start."
  update_module_status
  return 1
}

stop_service() {
  log Info "Stopping NetBird daemon."
  if ! is_running; then
    log Info "NetBird daemon is not running."
    return 0
  fi
  for pid in $(busybox pgrep -f "$NB_DAEMON_CMD" 2>/dev/null); do
    kill -15 "$pid" >/dev/null 2>&1 || true
  done
  sleep 3
  if is_running; then
    log Warning "NetBird daemon did not stop cleanly; forcing stop."
    for pid in $(busybox pgrep -f "$NB_DAEMON_CMD" 2>/dev/null); do
      kill -9 "$pid" >/dev/null 2>&1 || true
    done
  fi
  rm -f "$pid_file"
  stop_module_status
}

daemon_status() {
  if is_running; then
    echo "daemon: running"
    return 0
  fi
  echo "daemon: stopped"
  return 1
}

client_cmd() {
  refresh_runtime
  (
    unset NB_CONFIG
    netbird --daemon-addr "$NB_DAEMON_ADDR" "$@"
  )
}

up_cmd() {
  client_cmd up --disable-dns "$@"
  rc="$?"
  refresh_runtime
  return "$rc"
}

usage() {
  echo "usage: netbird.service {start|stop|restart|status|up|down|login|log|refresh|version}"
  echo "  up always adds --disable-dns before your extra flags."
}

case "${1:-}" in
  start)
    start_service
    ;;
  stop)
    stop_service
    ;;
  restart)
    stop_service
    sleep 1
    start_service
    ;;
  status)
    shift
    if daemon_status; then
      client_cmd status "$@"
      rc="$?"
      update_module_status
      exit "$rc"
    else
      update_module_status
      exit 1
    fi
    ;;
  up)
    shift
    start_service
    up_cmd "$@"
    rc="$?"
    update_module_status
    exit "$rc"
    ;;
  down)
    shift
    client_cmd down "$@"
    rc="$?"
    update_module_status
    exit "$rc"
    ;;
  login)
    shift
    start_service
    client_cmd login "$@"
    rc="$?"
    update_module_status
    exit "$rc"
    ;;
  log)
    busybox tail -n 200 -f "$NB_LOG_FILE_PATH"
    ;;
  refresh)
    refresh_runtime
    update_module_status
    ;;
  version)
    client_cmd version
    rc="$?"
    update_module_status
    exit "$rc"
    ;;
  *)
    usage
    ;;
esac
